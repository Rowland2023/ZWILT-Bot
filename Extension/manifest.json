{
  "manifest_version": 3,
  "name": "ZWILT Bot",
  "version": "14.3.6",
  "description": "Automates social media interactions using modular bots and platform-specific controllers.",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://web.facebook.com/*",
    "*://m.facebook.com/*",
    "*://*.instagram.com/*",
    "*://m.instagram.com/*",
    "*://*.twitter.com/*",
    "*://mobile.twitter.com/*",
    "*://*.linkedin.com/*",
    "*://*.tiktok.com/*",
    "*://*.pinterest.com/*",
    "*://*.tinder.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://web.facebook.com/*",
        "*://m.facebook.com/*"
      ],
      "js": ["src/content/facebookController.js"],
      "type": "module"
    },
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://m.instagram.com/*"
      ],
      "js": ["src/content/instagramController.js"],
      "type": "module"
    },
    {
      "matches": [
        "*://*.twitter.com/*",
        "*://mobile.twitter.com/*"
      ],
      "js": ["src/content/twitterController.js"],
      "type": "module"
    },
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://www.linkedin.com/*"
      ],
      "js": ["src/content/linkedinController.js"],
      "type": "module"
    },
    {
      "matches": [
        "*://*.tiktok.com/*",
        "*://www.tiktok.com/*"
      ],
      "js": ["src/content/tiktokController.js"],
      "type": "module"
    },
    {
      "matches": [
        "*://*.pinterest.com/*",
        "*://www.pinterest.com/*"
      ],
      "js": ["src/content/pinterestController.js"],
      "type": "module"
    },
    {
      "matches": [
        "*://*.tinder.com/*",
        "*://www.tinder.com/*"
      ],
      "js": ["src/content/tinderController.js"],
      "type": "module"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "popup/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
