{
  "manifest_version": 3,
  "name": "ZWILT Bot",
  "version": "14.3.6",
  "description": "Automates social media interactions using modular bots and platform-specific controllers.",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://web.facebook.com/*",
    "*://m.facebook.com/*",
    "*://*.instagram.com/*",
    "*://m.instagram.com/*",
    "*://*.twitter.com/*",
    "*://mobile.twitter.com/*",
    "*://x.com/*",
    "*://*.linkedin.com/*",
    "*://*.tiktok.com/*",
    "*://*.pinterest.com/*",
    "*://*.tinder.com/*"
  ],
  "web_accessible_resources": [
  {
    "resources": [
      "assets/*",
      "popup/*",
      "src/content/*.js",
      "content/*.js"
    ],
    "matches": ["<all_urls>"]
  }
]

}
